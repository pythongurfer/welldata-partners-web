---
import Layout from '../layouts/Layout.astro';
import ROICalculator from '../components/ROICalculator.astro'; // Importar
---

<Layout title="WellData Partners | Data Intelligence for O&G" description="Maximizing operational efficiency in Vaca Muerta through advanced data architecture and predictive analytics.">
	
	<section class="hero">
		<div class="container">
			<span class="badge">Advanced Data Architecture & Machine Learning</span>
			<h1>Turning Raw Sensor Data into <span class="text-gradient">Actionable Intelligence</span></h1>
			<p class="slogan">Bridging the Gap Between Field Data and Operational Excellence.</p>
			<p>We help O&G operators in Vaca Muerta reduce OPEX and eliminate NPT through edge-to-cloud infrastructure and predictive maintenance.</p>
			<div class="hero-actions">
				<a href="#services" class="btn-primary">Our Solutions</a>
				<a href="/blog" class="btn-secondary">Technical Insights</a>
			</div>
		</div>
	</section>

	<section id="about" class="about">
		<div class="container">
			<div class="section-header">
				<h2>Our Mission</h2>
			</div>
			<p class="mission-text">
				At WellData Partners, our mission is to empower O&G operators with the data infrastructure and predictive intelligence needed to thrive in the era of digital energy. By eliminating data silos and deploying edge-to-cloud solutions, we transform raw field information into a strategic asset that reduces OPEX and drives sustainable growth in unconventional basins.
			</p>
		</div>
	</section>

	<section id="services" class="services">
		<div class="container">
			<div class="section-header">
				<h2>Specialized Data Solutions</h2>
				<p>Bridging the gap between field sensors and boardroom decisions.</p>
			</div>

			<div class="services-grid">
				<div class="service-card">
					<div class="icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/><path d="M9 10V8a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
					</div>
					<h3>Edge-to-Cloud Architecture</h3>
					<p>Deploying robust data pipelines in remote environments. We solve connectivity challenges in the field to ensure zero-latency data ingestion.</p>
					<ul>
						<li>IIoT Sensor Integration</li>
						<li>Protocol Conversion (Modbus/OPC-UA)</li>
						<li>Unified Namespace (UNS) Design</li>
					</ul>
				</div>

				<div class="service-card">
					<div class="icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m19 20-3.5-3.5"/><circle cx="15" cy="15" r="3"/><path d="M2 20h.01"/><path d="M7 20h.01"/><path d="M12 20h.01"/><path d="m2 10 3-3 3 3 3-3 3 3"/></svg>
					</div>
					<h3>Predictive Operations</h3>
					<p>Moving from reactive to proactive maintenance. Our ML models detect failure patterns in Artificial Lift systems before they happen.</p>
					<ul>
						<li>Failure Prediction Models</li>
						<li>Anomaly Detection</li>
						<li>Optimization of Frac Fleets</li>
					</ul>
				</div>

				<div class="service-card">
					<div class="icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
					</div>
					<h3>Real-time Analytics</h3>
					<p>Visualizing what matters. Custom dashboards designed for superintendents and engineers to monitor field KPIs in real-time.</p>
					<ul>
						<li>Operational Dashboards</li>
						<li>Automated Reporting</li>
						<li>OPEX Tracking & Forecasting</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section id="calculator" class="calculator-section">
		<div class="container">
			<div class="section-header">
				<h2>Calculate Your Savings</h2>
				<p>See the real economic impact of optimizing your artificial lift operations.</p>
			</div>
			<ROICalculator />
		</div>
	</section>

</Layout>

<style>
	.container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
	
	/* Hero */
	.hero { padding: 10rem 0 6rem; text-align: center; }
	.badge { background: rgba(37, 99, 235, 0.1); color: var(--accent); padding: 0.5rem 1rem; border-radius: 2rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
	h1 { font-size: 4rem; line-height: 1.1; margin: 1.5rem 0; font-weight: 800; }
	.text-gradient { background: linear-gradient(to right, #2563EB, #60A5FA); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
	p { color: var(--text-muted); font-size: 1.25rem; max-width: 700px; margin: 0 auto 2.5rem; }
	
	.hero-actions { display: flex; gap: 1rem; justify-content: center; }
	.btn-primary { background: var(--accent); color: white; padding: 1rem 2rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; }
	.btn-secondary { border: 1px solid rgba(255,255,255,0.2); color: white; padding: 1rem 2rem; border-radius: 0.5rem; text-decoration: none; }

	.slogan {
		font-size: 1.4rem;
		font-weight: 600;
		color: #60A5FA;
		margin-bottom: 1rem;
		letter-spacing: -0.01em;
	}

	/* About / Mission */
	.about { padding: 6rem 0; border-top: 1px solid rgba(255,255,255,0.05); }
	.mission-text {
		font-size: 1.3rem;
		line-height: 1.8;
		color: var(--text-muted);
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	/* Services */
	.services { padding: 8rem 0; background: rgba(255,255,255,0.02); }

	/* Calculator */
	.calculator-section {
		padding: 6rem 0 8rem;
		background: linear-gradient(180deg, transparent 0%, rgba(37, 99, 235, 0.03) 50%, transparent 100%);
		border-top: 1px solid rgba(255,255,255,0.05);
	}

	.section-header { text-align: center; margin-bottom: 4rem; }
	.section-header h2 { font-size: 2.5rem; margin-bottom: 1rem; }
	
	.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
	
	.service-card { 
		background: rgba(255,255,255,0.03); 
		padding: 3rem 2rem; 
		border-radius: 1rem; 
		border: 1px solid rgba(255,255,255,0.05);
		transition: transform 0.3s ease;
	}
	.service-card:hover { transform: translateY(-10px); border-color: var(--accent); }
	.icon { 
    margin-bottom: 1.5rem;
    color: var(--accent); /* Usará el azul que definimos */
    display: flex;
    align-items: center;
    justify-content: flex-start;
	}
	.icon svg {
    opacity: 0.9;
    /* Un pequeño resplandor sutil para que destaquen en el fondo oscuro */
    filter: drop-shadow(0 0 8px rgba(37, 99, 235, 0.3));
	}
	h3 { font-size: 1.5rem; margin-bottom: 1rem; color: white; }
	.service-card p { font-size: 1rem; text-align: left; margin-bottom: 1.5rem; }
	
	ul { list-style: none; padding: 0; text-align: left; }
	li { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem; display: flex; align-items: center; }
	li::before { content: "→"; color: var(--accent); margin-right: 10px; font-weight: bold; }

	@media (max-width: 768px) {
		h1 { font-size: 2.5rem; }
	}
</style>


