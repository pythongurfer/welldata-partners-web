---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | WellData Partners`} description={entry.data.description}>
    <article class="article-content">
        <header>
            <a href="/blog" class="back-link">← Back to Insights</a>
            <div class="meta">{entry.data.pubDate.toDateString()} | By {entry.data.author}</div>
            <h1>{entry.data.title}</h1>
        </header>
        <div class="markdown-body">
            <Content />
        </div>
    </article>
</Layout>

<style>
    .article-content {
        max-width: 700px;
        margin: 0 auto;
        padding: 6rem 2rem;
    }
    .back-link { color: var(--accent); text-decoration: none; display: block; margin-bottom: 2rem; }
    .meta { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
    h1 { font-size: 3rem; line-height: 1.2; margin-bottom: 3rem; }
    
    /* Estilos para el contenido Markdown */
    .markdown-body {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #D1D5DB;
    }
    .markdown-body :global(h2) { color: white; margin-top: 3rem; }
    .markdown-body :global(p) { margin-bottom: 1.5rem; }
</style>