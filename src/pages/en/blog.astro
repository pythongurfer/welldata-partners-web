---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const enPosts = posts.filter(p => p.data.lang === 'en');
enPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Insights | WellData Partners" description="Technical analysis and operational efficiency strategies for the O&G industry." lang="en" hreflangEs="https://welldatapartners.com/blog" hreflangEn="https://welldatapartners.com/en/blog">
    <main class="blog-page">
        <header class="blog-header">
            <div class="container">
                <a href="/" class="back-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    Home
                </a>
                <div class="lang-switcher">
                    <a href="/blog" class="lang-link">ES</a>
                    <span class="lang-active">EN</span>
                </div>
                <div class="section-label">Technical Insights</div>
                <h1>Analysis & Strategy</h1>
                <p>OPEX reduction strategies and data-driven operations for upstream operators.</p>
            </div>
        </header>

        <section class="posts-section">
            <div class="container">
                <div class="post-list">
                    {enPosts.map((post, index) => (
                        <a href={`/en/blog/${post.id.replace('en/', '')}`} class="post-card">
                            <div class="post-index">{String(index + 1).padStart(2, '0')}</div>
                            <div class="post-body">
                                <div class="post-meta">
                                    <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                                    <span class="meta-sep">&middot;</span>
                                    <span>{post.data.author}</span>
                                </div>
                                <h2>{post.data.title}</h2>
                                <p class="post-excerpt">{post.data.description}</p>
                                <div class="post-tags">
                                    {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                                </div>
                            </div>
                            <div class="post-arrow">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .blog-page {
        min-height: 100vh;
    }
    .container {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 var(--space-xl);
    }
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: var(--space-2xl);
        transition: color var(--transition-fast);
    }
    .back-link:hover { color: var(--accent-light); }
    .lang-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: var(--space-xl);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
    }
    .lang-active {
        color: var(--accent-light);
        border-bottom: 1px solid var(--accent-light);
        padding-bottom: 1px;
    }
    .lang-link {
        color: var(--text-muted);
        transition: color var(--transition-fast);
    }
    .lang-link:hover { color: var(--text-secondary); }
    .section-label {
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--accent-light);
        margin-bottom: var(--space-md);
    }
    .blog-header {
        padding: var(--space-3xl) 0 var(--space-4xl);
        border-bottom: 1px solid var(--border-primary);
    }
    .blog-header h1 {
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        font-weight: 400;
        letter-spacing: -0.01em;
        margin-bottom: var(--space-md);
    }
    .blog-header p {
        color: var(--text-tertiary);
        font-size: 1.125rem;
        max-width: 480px;
    }
    .posts-section {
        padding: var(--space-3xl) 0 var(--space-5xl);
    }
    .post-list {
        display: flex;
        flex-direction: column;
    }
    .post-card {
        display: flex;
        align-items: flex-start;
        gap: var(--space-xl);
        padding: var(--space-2xl) 0;
        border-bottom: 1px solid var(--border-primary);
        transition: all var(--transition-base);
        text-decoration: none;
    }
    .post-card:first-child { padding-top: 0; }
    .post-card:hover { padding-left: var(--space-md); }
    .post-index {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
        padding-top: 0.125rem;
    }
    .post-body { flex: 1; }
    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: var(--text-muted);
        margin-bottom: var(--space-sm);
    }
    .meta-sep { opacity: 0.4; }
    .post-card h2 {
        font-size: 1.375rem;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.35;
        margin-bottom: var(--space-sm);
        transition: color var(--transition-fast);
    }
    .post-card:hover h2 { color: var(--accent-light); }
    .post-excerpt {
        font-size: 0.9375rem;
        color: var(--text-tertiary);
        line-height: 1.6;
        margin-bottom: var(--space-md);
    }
    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
    }
    .tag {
        font-size: 0.6875rem;
        font-weight: 500;
        color: var(--text-muted);
        border: 1px solid var(--border-primary);
        padding: 0.1875rem 0.5rem;
        border-radius: var(--radius-sm);
        letter-spacing: 0.02em;
    }
    .post-arrow {
        flex-shrink: 0;
        color: var(--text-muted);
        opacity: 0;
        transform: translateX(-8px);
        transition: all var(--transition-base);
        padding-top: 0.25rem;
    }
    .post-card:hover .post-arrow {
        opacity: 1;
        transform: translateX(0);
    }
    @media (max-width: 768px) {
        .post-index { display: none; }
        .post-arrow { display: none; }
        .post-card:hover { padding-left: 0; }
    }
</style>
