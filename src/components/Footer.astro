---
const currentYear = new Date().getFullYear();
---
<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="/" class="logo">
                    <span class="well">Well</span>Data <span class="partners">Partners</span>
                </a>
                <p>Data Intelligence for the Energy Sector.<br/>Specialized in Vaca Muerta operations.</p>
            </div>
            
            <div class="footer-links">
                <h4>Navigation</h4>
                <a href="/">Home</a>
                <a href="/#services">Services</a>
                <a href="/blog">Insights</a>
            </div>

            <div class="footer-contact">
                <h4>Contact</h4>
                <a href="mailto:contact@welldatapartners.com">contact@welldatapartners.com</a>
                <a href="https://www.linkedin.com/company/welldata-partners/" target="_blank">LinkedIn Page</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; {currentYear} WellData Partners. All rights reserved.</p>
            <div class="locations">
                <span>Berlin, Germany</span>
                <span class="separator">|</span>
                <span>Neuquén, Argentina</span>
            </div>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: #050A18; /* Un tono más oscuro que el fondo principal */
        padding: 5rem 0 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        color: var(--text-muted);
    }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
    
    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 4rem;
        margin-bottom: 4rem;
    }

    .logo {
        font-size: 1.3rem;
        font-weight: 800;
        text-decoration: none;
        color: white;
        display: block;
        margin-bottom: 1rem;
    }
    .well { color: var(--accent); }
    .footer-brand p { font-size: 0.9rem; line-height: 1.6; }

    h4 { color: white; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem; }
    
    .footer-links, .footer-contact { display: flex; flex-direction: column; gap: 0.8rem; }
    .footer-links a, .footer-contact a {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.9rem;
        transition: color 0.2s;
    }
    .footer-links a:hover, .footer-contact a:hover { color: var(--accent); }

    .footer-bottom {
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
    }
    .locations { display: flex; gap: 0.5rem; opacity: 0.6; }
    .separator { color: var(--accent); }

    @media (max-width: 768px) {
        .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
        .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
    }
</style>