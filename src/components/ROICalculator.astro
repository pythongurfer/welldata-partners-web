---
---
<div class="calculator-wrapper">
    <div class="calculator-card">
        <div class="calc-inputs">
            <div class="input-group">
                <label for="wells">Active Wells</label>
                <div class="input-wrapper">
                    <input type="number" id="wells" value="10" min="1" max="500" />
                    <span class="input-suffix">wells</span>
                </div>
            </div>

            <div class="input-group">
                <label for="workovers">Workovers per Well / Year</label>
                <div class="input-wrapper">
                    <input type="number" id="workovers" value="1.5" step="0.1" />
                    <span class="input-suffix">/ yr</span>
                </div>
            </div>

            <div class="input-group">
                <label for="cost">Average Workover Cost</label>
                <div class="input-wrapper">
                    <span class="input-prefix">USD</span>
                    <input type="number" id="cost" value="150000" step="5000" class="has-prefix" />
                </div>
            </div>
        </div>

        <div class="calc-divider"></div>

        <div class="calc-results">
            <div class="result-row">
                <span class="result-label">Current Estimated Spend</span>
                <span class="result-value" id="current-loss">USD 2,250,000</span>
            </div>
            <div class="result-row highlight">
                <span class="result-label">Potential Annual Savings</span>
                <span class="result-value savings" id="potential-saving">USD 450,000</span>
            </div>
            <div class="savings-note">Based on a conservative 20% reduction through predictive maintenance</div>
        </div>

        <a href="mailto:contact@welldatapartners.com" class="calc-cta">
            Request Detailed Diagnostic Report
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
    </div>
</div>

<script>
    const wellsInput = document.getElementById('wells');
    const workoversInput = document.getElementById('workovers');
    const costInput = document.getElementById('cost');

    const currentLossEl = document.getElementById('current-loss');
    const potentialSavingEl = document.getElementById('potential-saving');

    function calculate() {
        const wells = parseFloat(wellsInput?.value || '0');
        const workovers = parseFloat(workoversInput?.value || '0');
        const cost = parseFloat(costInput?.value || '0');

        const totalLoss = wells * workovers * cost;
        const savings = totalLoss * 0.20;

        if (currentLossEl) currentLossEl.innerText = `USD ${totalLoss.toLocaleString('en-US')}`;
        if (potentialSavingEl) potentialSavingEl.innerText = `USD ${savings.toLocaleString('en-US')}`;
    }

    [wellsInput, workoversInput, costInput].forEach(input => {
        input?.addEventListener('input', calculate);
    });
</script>

<style>
    .calculator-wrapper {
        display: flex;
        justify-content: center;
    }

    .calculator-card {
        width: 100%;
        max-width: 520px;
        background: var(--bg-card);
        border: 1px solid var(--border-primary);
        border-radius: var(--radius-xl);
        padding: var(--space-2xl);
        position: relative;
        overflow: hidden;
    }
    .calculator-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--accent), transparent);
    }

    .input-group {
        margin-bottom: var(--space-lg);
    }
    .input-group:last-child { margin-bottom: 0; }

    label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-tertiary);
        margin-bottom: var(--space-sm);
        letter-spacing: 0.01em;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    input[type="number"] {
        width: 100%;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-primary);
        padding: 0.75rem 1rem;
        border-radius: var(--radius-md);
        color: var(--text-primary);
        font-family: 'DM Sans', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
        -moz-appearance: textfield;
    }
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"]:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-glow);
    }
    input.has-prefix { padding-left: 3rem; }

    .input-prefix {
        position: absolute;
        left: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-muted);
        pointer-events: none;
    }
    .input-suffix {
        position: absolute;
        right: 1rem;
        font-size: 0.8125rem;
        color: var(--text-muted);
        pointer-events: none;
    }

    .calc-divider {
        height: 1px;
        background: var(--border-primary);
        margin: var(--space-xl) 0;
    }

    .calc-results {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }
    .result-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .result-label {
        font-size: 0.875rem;
        color: var(--text-tertiary);
    }
    .result-value {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .result-row.highlight {
        background: var(--success-glow);
        margin: 0 calc(var(--space-xl) * -1);
        padding: var(--space-md) var(--space-xl);
        border-radius: var(--radius-md);
    }
    .savings {
        color: var(--success) !important;
        font-size: 1.375rem;
        font-weight: 700;
    }
    .savings-note {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-align: center;
        margin-top: var(--space-xs);
    }

    .calc-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        margin-top: var(--space-xl);
        padding: 0.8125rem;
        background: linear-gradient(135deg, var(--accent), var(--cyan));
        color: white;
        font-weight: 600;
        font-size: 0.8125rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        border-radius: var(--radius-sm);
        transition: all var(--transition-base);
    }
    .calc-cta:hover {
        background: linear-gradient(135deg, var(--accent-light), var(--cyan-light));
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
    }
    .calc-cta svg { transition: transform var(--transition-fast); }
    .calc-cta:hover svg { transform: translateX(2px); }
</style>