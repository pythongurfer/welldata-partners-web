---
---
<section class="roi-calculator" id="calculator">
    <div class="calculator-card">
        <h3>Calculadora de Impacto Económico (OPEX)</h3>
        <p>Estime cuánto capital podría recuperar optimizando su infraestructura de datos.</p>
        
        <div class="input-group">
            <label for="wells">Número de Pozos Activos:</label>
            <input type="number" id="wells" value="10" min="1" max="500">
        </div>

        <div class="input-group">
            <label for="workovers">Intervenciones (Workovers) por año/pozo:</label>
            <input type="number" id="workovers" value="1.5" step="0.1">
        </div>

        <div class="input-group">
            <label for="cost">Costo promedio por Workover (USD):</label>
            <input type="number" id="cost" value="150000" step="5000">
        </div>

        <hr />

        <div class="results">
            <div class="result-item">
                <span>Pérdida Actual Estimada:</span>
                <strong id="current-loss">USD 2,250,000</strong>
            </div>
            <div class="result-item accent">
                <span>Ahorro Potencial Anual (WellData):</span>
                <strong id="potential-saving">USD 450,000</strong>
            </div>
        </div>

        <div class="cta-calc">
            <a href="mailto:contact@welldatapartners.com" class="btn-calc">Solicitar Informe de Diagnóstico Detallado</a>
        </div>
    </div>
</section>

<script>
    const wellsInput = document.getElementById('wells');
    const workoversInput = document.getElementById('workovers');
    const costInput = document.getElementById('cost');
    
    const currentLossEl = document.getElementById('current-loss');
    const potentialSavingEl = document.getElementById('potential-saving');

    function calculate() {
        const wells = parseFloat(wellsInput.value) || 0;
        const workovers = parseFloat(workoversInput.value) || 0;
        const cost = parseFloat(costInput.value) || 0;

        // Pérdida total anual
        const totalLoss = wells * workovers * cost;
        
        // Asumimos una reducción conservadora del 20% con nuestra arquitectura
        const savings = totalLoss * 0.20;

        currentLossEl.innerText = `USD ${totalLoss.toLocaleString()}`;
        potentialSavingEl.innerText = `USD ${savings.toLocaleString()}`;
    }

    [wellsInput, workoversInput, costInput].forEach(input => {
        input.addEventListener('input', calculate);
    });
</script>

<style>
    .roi-calculator { padding: 4rem 2rem; display: flex; justify-content: center; }
    .calculator-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 2.5rem;
        border-radius: 1.5rem;
        max-width: 500px;
        width: 100%;
        backdrop-filter: blur(10px);
    }
    h3 { margin-bottom: 0.5rem; color: white; }
    p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 2rem; }
    
    .input-group { margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
    label { font-size: 0.85rem; color: var(--text-main); }
    input {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0.8rem;
        border-radius: 0.5rem;
        color: white;
        font-size: 1rem;
    }
    hr { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 2rem 0; }
    
    .results { display: flex; flex-direction: column; gap: 1rem; }
    .result-item { display: flex; justify-content: space-between; align-items: center; }
    .result-item span { font-size: 0.9rem; color: var(--text-muted); }
    .result-item strong { font-size: 1.2rem; }
    .accent strong { color: #10B981; font-size: 1.5rem; } /* Color verde éxito */

    .cta-calc { margin-top: 2rem; }
    .btn-calc {
        display: block;
        text-align: center;
        background: var(--accent);
        color: white;
        padding: 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.2s;
    }
    .btn-calc:hover { transform: scale(1.02); }
</style>