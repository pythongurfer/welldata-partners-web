---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const { title, description = "WellData Partners: Advanced Data Architecture and Machine Learning for O&G Operators.", lang = 'es', hreflangEs, hreflangEn, schema } = Astro.props;
const canonicalURL = Astro.url.href;
const ogImage = 'https://welldatapartners.com/linkedin-preview.jpg';
const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "WellData Partners",
  "url": "https://welldatapartners.com",
  "logo": "https://welldatapartners.com/favicon.svg",
  "description": "Data architecture and machine learning consulting for upstream oil & gas operators. We reduce OPEX and eliminate NPT through edge-to-cloud infrastructure and predictive analytics.",
  "email": "contact@welldatapartners.com",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "contact@welldatapartners.com",
    "contactType": "sales",
    "availableLanguage": ["English", "Spanish"]
  },
  "sameAs": ["https://www.linkedin.com/company/welldata-partners/"]
});
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content="Oil and Gas, Vaca Muerta, Machine Learning, Data Architecture, OPEX reduction, Predictive Maintenance" />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={schema ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="WellData Partners" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_AR'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {hreflangEs && <link rel="alternate" hreflang="es" href={hreflangEs} />}
    {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
    {hreflangEn && <link rel="alternate" hreflang="x-default" href={hreflangEn} />}

    <script type="application/ld+json" set:html={organizationSchema} />
    {schema && <script type="application/ld+json" set:html={schema} />}

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CZ0DH2Z18H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CZ0DH2Z18H');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;400;500;600;700&1,9..40,400&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style is:global>
        /* ═══════════════════════════════════════════
           DESIGN SYSTEM — WellData Partners
           Premium boutique consulting aesthetic
        ═══════════════════════════════════════════ */
        :root {
            /* Backgrounds */
            --bg-primary: #030712;
            --bg-secondary: #0A1128;
            --bg-elevated: #111827;
            --bg-card: rgba(17, 24, 39, 0.6);
            --bg-card-hover: rgba(17, 24, 39, 0.8);

            /* Text */
            --text-primary: #F9FAFB;
            --text-secondary: #D1D5DB;
            --text-tertiary: #9CA3AF;
            --text-muted: #6B7280;

            /* Accent — brand blue (logo-aligned) */
            --accent: #3B82F6;
            --accent-light: #60A5FA;
            --accent-dark: #2563EB;
            --accent-glow: rgba(59, 130, 246, 0.1);
            --accent-glow-strong: rgba(59, 130, 246, 0.2);

            /* Cyan — gradient endpoint (logo-aligned) */
            --cyan: #06B6D4;
            --cyan-light: #22D3EE;

            /* Success */
            --success: #2D9B6E;
            --success-glow: rgba(45, 155, 110, 0.1);

            /* Borders & Surfaces */
            --border-primary: rgba(255, 255, 255, 0.06);
            --border-hover: rgba(255, 255, 255, 0.12);
            --border-accent: rgba(59, 130, 246, 0.25);

            /* Shadows */
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.25);
            --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.35);
            --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.45);
            --shadow-glow: 0 0 40px rgba(59, 130, 246, 0.06);

            /* Spacing */
            --space-xs: 0.25rem;
            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2rem;
            --space-2xl: 3rem;
            --space-3xl: 4rem;
            --space-4xl: 6rem;
            --space-5xl: 8rem;

            /* Radius — sharper for executive feel */
            --radius-sm: 0.25rem;
            --radius-md: 0.5rem;
            --radius-lg: 0.625rem;
            --radius-xl: 0.75rem;

            /* Transitions */
            --transition-fast: 150ms ease;
            --transition-base: 250ms ease;
            --transition-slow: 400ms ease;

            /* Layout */
            --max-width: 1200px;
            --content-width: 720px;
            --nav-height: 72px;
        }

        /* Reset */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-secondary);
            line-height: 1.65;
            font-optical-sizing: auto;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
            overflow-x: hidden;
        }

        ::selection {
            background-color: var(--accent);
            color: white;
        }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-primary); }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }

        h1, h2, h3 {
            color: var(--text-primary);
            font-family: 'DM Serif Display', Georgia, 'Times New Roman', serif;
            font-weight: 400;
            line-height: 1.15;
            letter-spacing: -0.01em;
        }
        h4, h5, h6 {
            color: var(--text-primary);
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            line-height: 1.3;
            letter-spacing: -0.01em;
        }

        a { color: inherit; text-decoration: none; }
        img { max-width: 100%; display: block; }

        main {
            padding-top: var(--nav-height);
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
    </style>
</head>
<body>
    <Navbar />
    <slot />
    <Footer />

    <!-- Book a call floating CTA -->
    <!-- TODO: replace with your Cal.com link once you create an account at cal.com -->
    <a
      href="https://cal.com/welldata-partners/intro"
      class="book-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Book a call"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
      <span>Book a call</span>
    </a>

    <style>
      .book-fab {
        position: fixed;
        bottom: 1.75rem;
        right: 1.75rem;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.15rem;
        border-radius: 2rem;
        background: var(--accent);
        color: #fff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(59,130,246,0.35);
        transition: transform 200ms ease, box-shadow 200ms ease, background 200ms ease;
      }
      .book-fab:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(59,130,246,0.5);
      }
      @media (max-width: 480px) {
        .book-fab span { display: none; }
        .book-fab { padding: 0.75rem; border-radius: 50%; }
      }
    </style>
</body>
</html>