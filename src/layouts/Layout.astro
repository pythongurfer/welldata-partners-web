---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const { title, description = "WellData Partners: Advanced Data Architecture and Machine Learning for O&G Operators." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content="Oil and Gas, Vaca Muerta, Machine Learning, Data Architecture, OPEX reduction, Predictive Maintenance" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://welldatapartners.com/linkedin-preview.jpg" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CZ0DH2Z18H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CZ0DH2Z18H');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;400;500;600;700&1,9..40,400&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style is:global>
        /* ═══════════════════════════════════════════
           DESIGN SYSTEM — WellData Partners
           Premium boutique consulting aesthetic
        ═══════════════════════════════════════════ */
        :root {
            /* Backgrounds */
            --bg-primary: #030712;
            --bg-secondary: #0A1128;
            --bg-elevated: #111827;
            --bg-card: rgba(17, 24, 39, 0.6);
            --bg-card-hover: rgba(17, 24, 39, 0.8);

            /* Text */
            --text-primary: #F9FAFB;
            --text-secondary: #D1D5DB;
            --text-tertiary: #9CA3AF;
            --text-muted: #6B7280;

            /* Accent */
            --accent: #3B82F6;
            --accent-light: #60A5FA;
            --accent-dark: #2563EB;
            --accent-glow: rgba(59, 130, 246, 0.15);
            --accent-glow-strong: rgba(59, 130, 246, 0.25);

            /* Success */
            --success: #10B981;
            --success-glow: rgba(16, 185, 129, 0.12);

            /* Borders & Surfaces */
            --border-primary: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.15);
            --border-accent: rgba(59, 130, 246, 0.3);

            /* Shadows */
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
            --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.5);
            --shadow-glow: 0 0 40px rgba(59, 130, 246, 0.08);

            /* Spacing */
            --space-xs: 0.25rem;
            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2rem;
            --space-2xl: 3rem;
            --space-3xl: 4rem;
            --space-4xl: 6rem;
            --space-5xl: 8rem;

            /* Radius */
            --radius-sm: 0.375rem;
            --radius-md: 0.75rem;
            --radius-lg: 1rem;
            --radius-xl: 1.5rem;

            /* Transitions */
            --transition-fast: 150ms ease;
            --transition-base: 250ms ease;
            --transition-slow: 400ms ease;

            /* Layout */
            --max-width: 1200px;
            --content-width: 720px;
            --nav-height: 72px;
        }

        /* Reset */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-secondary);
            line-height: 1.65;
            font-optical-sizing: auto;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
            overflow-x: hidden;
        }

        ::selection {
            background-color: var(--accent);
            color: white;
        }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-primary); }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }

        h1, h2, h3 {
            color: var(--text-primary);
            font-family: 'DM Serif Display', Georgia, 'Times New Roman', serif;
            font-weight: 400;
            line-height: 1.15;
            letter-spacing: -0.01em;
        }
        h4, h5, h6 {
            color: var(--text-primary);
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            line-height: 1.3;
            letter-spacing: -0.01em;
        }

        a { color: inherit; text-decoration: none; }
        img { max-width: 100%; display: block; }

        main {
            padding-top: var(--nav-height);
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
    </style>
</head>
<body>
    <Navbar />
    <slot />
    <Footer />
</body>
</html>