# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example

# public images (large raster assets, not tracked in git)
public/images/*.png
public/images/*.jpg
public/images/*.jpeg
public/images/*.gif
public/images/*.webp
# SVG logos ARE tracked
!public/images/logo-welldata.svg

# macOS-specific files
.DS_Store
.AppleDouble
.LSOverride
._*
**/.DS_Store

# editor / IDE settings
.idea/
.vscode/
*.swp
*.swo

# secrets / credentials
*.pem
*.key
*.cert
*.p12
